#!/usr/bin/env bash
# Show a JankyBorders overlay only while a temporary AeroSpace binding mode is
# active; hide it on return to main.
#
# AeroSpace binding modes are otherwise invisible: nothing on screen tells you
# that `arrange` is still active, so stray typing silently drives window
# commands. A coloured border on the focused window makes the mode legible in
# peripheral vision.
#
# The border is only wanted in the temporary modes: macOS draws its own drop
# shadow around the border layer and there is no way to suppress it with SIP
# enabled (JankyBorders issue #173). That artifact is tolerable as a transient
# mode cue but not as permanent desktop chrome.
#
# Main mode therefore retunes the overlay to invisible rather than killing it.
# A freshly started `borders` only paints once it observes a focus change, so
# stopping the process made the border miss the already-focused window on the
# next mode entry. Keeping it warm makes the cue appear immediately.
#
# Colours come from the cyanotype charcoal scheme shared with the ghostty rite.
# Invoked from the mode bindings in rites/aerospace/base.toml.
#
# Usage: tint-borders <main|service|arrange>

set -euo pipefail

BORDERS=/opt/homebrew/bin/borders

# Only the focused window is ever marked, so inactive borders stay transparent.
COMMON="inactive_color=0x00000000 hidpi=on style=round"

case "${1:-}" in
    # Fully transparent AND zero width, so nothing is drawn to cast a shadow.
    main)    tint="active_color=0x00000000 width=0.0" ;;
    service) tint="active_color=0xffbea6fd width=8.0" ;;  # violet
    arrange) tint="active_color=0xffff4d65 width=8.0" ;;  # red
    *)
        echo "usage: ${0##*/} <main|service|arrange>" >&2
        exit 64
        ;;
esac

# If an instance is already running, `borders` hands the new arguments to it and
# exits; otherwise it starts and stays in the foreground (see borders(1)). Both
# are fine under exec-and-forget.
exec "$BORDERS" $tint $COMMON
