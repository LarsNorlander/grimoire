#!/usr/bin/env python3
import subprocess
from pathlib import Path

from arcana.tome import RiteContext

# node is managed by nvm (installed via Homebrew in the shared base rune,
# sourced in rites/zsh/zshrc). nvm is a shell function rather than a binary,
# so bootstrapping a node version has to run inside a bash that sources
# nvm.sh. Guarded twice, mirroring how the zsh rite bootstraps oh-my-zsh:
#   - skip if nvm isn't installed yet (runes not inscribed on a fresh box)
#   - skip if a default node already exists
# so this installs LTS exactly once and is a no-op on every later cast.
NVM_SH = "/opt/homebrew/opt/nvm/nvm.sh"


def _nvm(command, **kwargs):
    return subprocess.run(
        ["bash", "-c", f'export NVM_DIR="$HOME/.nvm"; . "{NVM_SH}"; {command}'],
        **kwargs,
    )


def install_node():
    if not Path(NVM_SH).exists():
        return
    if _nvm("nvm which default", capture_output=True).returncode == 0:
        return
    _nvm('nvm install --lts && nvm alias default "lts/*"', check=True)


ctx = RiteContext.from_args()
ctx.hook("install node (lts) via nvm", install_node)
