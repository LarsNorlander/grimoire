# Managed by grimoire — do not edit directly; use: grimoire accept zsh

export EDITOR="nvim"

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh/custom"
DISABLE_AUTO_UPDATE=true

ZSH_THEME=""
plugins=(git)

export PATH="$HOME/.npm-global/bin:$HOME/.grimoire:$HOME/.grimoire/cantrips:$HOME/.local/bin:$HOME/Workbench/scripts:$PATH"

# fpath extensions — must precede oh-my-zsh (which calls compinit internally)
fpath=("$HOME/.config/zsh/completions" $fpath)
[[ -f ~/.config/zsh/secrets.zsh ]] && source ~/.config/zsh/secrets.zsh
[[ -f ~/.config/zsh/profile.zsh ]] && source ~/.config/zsh/profile.zsh

# nvm — node is managed by nvm on every profile (installed via Homebrew).
# Guards are no-ops until `brew install nvm` has run, so this is safe on a
# fresh machine before the runes are inscribed.
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

source "$ZSH/oh-my-zsh.sh"

# Starship — must follow oh-my-zsh to override PROMPT
eval "$(starship init zsh)"

# Ghostty shell integration — auto-injected only in the shell Ghostty spawns
# directly, so shells inside tmux need this manual source (no-op elsewhere)
if [ -n "${GHOSTTY_RESOURCES_DIR}" ]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi
